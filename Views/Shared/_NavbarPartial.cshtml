@{
    var action = ViewBag.ForceActiveAction as string ?? ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var projectsActive = controller == "Home" && (action == "Projects" || action == "DemoFrame");
}
<header>
    <nav class="navbar navbar-expand-lg navbar-portfolio">
        <div class="container navbar-container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand" href="/" aria-label="Anastasiia Portfolio home">
                <img src="~/images/logo-ak-serif.svg" alt="AK" class="navbar-logo" data-skip-global-img asp-append-version="true" />
            </a>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav navbar-nav--main ms-lg-auto">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" && (action == "Index" || string.IsNullOrEmpty(action)) ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(projectsActive ? "active" : "")" asp-controller="Home" asp-action="Projects">Projects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" && action == "Resume" ? "active" : "")" asp-controller="Home" asp-action="Resume">Resume</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" && action == "Skills" ? "active" : "")" asp-controller="Home" asp-action="Skills">Skills</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" && action == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
