@{
    Layout = "_DemoChromeLayout";
    var demoTitle = ViewBag.DemoTitle as string ?? "Project Demo";
    var demoSrc = ViewBag.DemoSrc as string ?? "/";
    var demoUrlLabel = ViewBag.DemoUrlLabel as string ?? demoTitle;
}

<div class="demo-page-shell">
    <div class="demo-page-popup demo-modal__container">
        <div class="demo-modal__header demo-page-popup__header">
            <div class="demo-modal__browser-dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <span class="demo-modal__url">@demoUrlLabel</span>
            <a asp-controller="Home" asp-action="Projects" class="demo-modal__close" title="Back to Projects"><i class="fas fa-times"></i></a>
        </div>
        <iframe class="demo-modal__iframe demo-page-popup__iframe" src="@demoSrc" title="@demoTitle"></iframe>
    </div>
</div>
