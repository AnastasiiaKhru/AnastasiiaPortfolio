@model AnastasiiaPortfolio.Models.HomeViewModel

@{
    ViewData["Title"] = "Contact";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contact-page.css" asp-append-version="true" />
}

<div class="page-inner page-inner--contact">
    <header class="page-header">
        <div class="container">
            <p class="page-header__label" data-motion-before-typewriter>Contact</p>
            <h1 class="page-header__title text-gradient-motion" data-typewriter data-typewriter-text="Get in Touch" data-typewriter-speed="56"></h1>
            <p class="page-header__lead" data-motion-after-typewriter>Reach out by email or phone — I'd love to hear about your project. I typically reply within 24 hours.</p>
        </div>
    </header>

    <section class="contact-showcase" aria-label="Contact options">
        <div class="container contact-page">
            <div class="contact-highlights">
                <article class="contact-highlight reveal-ready">
                    <span class="contact-highlight__icon" aria-hidden="true"><i class="fas fa-clock"></i></span>
                    <p class="contact-highlight__title">Fast response</p>
                    <p class="contact-highlight__text">Usually replies within 24 hours on business days.</p>
                </article>
                <article class="contact-highlight reveal-ready">
                    <span class="contact-highlight__icon" aria-hidden="true"><i class="fas fa-globe-americas"></i></span>
                    <p class="contact-highlight__title">Remote-friendly</p>
                    <p class="contact-highlight__text">Based in Niagara Region, Canada — working with clients worldwide.</p>
                </article>
                <article class="contact-highlight reveal-ready">
                    <span class="contact-highlight__icon" aria-hidden="true"><i class="fas fa-handshake"></i></span>
                    <p class="contact-highlight__title">Open to work</p>
                    <p class="contact-highlight__text">Freelance, contract, and long-term collaboration opportunities.</p>
                </article>
            </div>

            <div class="contact-grid contact-grid--single">
                <div class="contact-info-card reveal-ready">
                    <h3>Contact information</h3>

                    <div class="contact-item">
                        <div class="contact-item-icon email">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-item-content">
                            <div class="contact-item-label">Email</div>
                            <div class="contact-item-value">
                                <a href="mailto:nastiakhru@gmail.com">nastiakhru@gmail.com</a>
                            </div>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-item-icon phone">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="contact-item-content">
                            <div class="contact-item-label">Phone</div>
                            <div class="contact-item-value">
                                <a href="tel:+19053241507">(905) 324-1507</a>
                            </div>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-item-icon location">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="contact-item-content">
                            <div class="contact-item-label">Location</div>
                            <div class="contact-item-value">Niagara Region, Canada</div>
                        </div>
                    </div>

                    <div class="availability-badge">
                        Available for new projects
                    </div>

                    <div class="quick-actions">
                        <a class="quick-action" href="mailto:nastiakhru@gmail.com"><i class="fas fa-paper-plane"></i> Email now</a>
                        <a class="quick-action" href="tel:+19053241507"><i class="fas fa-phone-alt"></i> Call now</a>
                    </div>
                    <p class="response-note">Prefer email? Include your timeline, goals, and any links.</p>
                </div>
            </div>

            <div class="contact-help reveal-ready">
                <h3 class="contact-help__title">What I can help with</h3>
                <div class="contact-help__tags">
                    <span class="contact-help__tag">New website or rebrand</span>
                    <span class="contact-help__tag">Shopify store setup</span>
                    <span class="contact-help__tag">WordPress theme build</span>
                    <span class="contact-help__tag">Custom web app</span>
                    <span class="contact-help__tag">UI/UX &amp; landing pages</span>
                    <span class="contact-help__tag">SEO &amp; performance</span>
                    <span class="contact-help__tag">Ongoing support</span>
                </div>
            </div>

            <div class="social-section reveal-ready">
                <h3>Connect with me</h3>
                <div class="social-buttons">
                    <a href="https://www.linkedin.com/in/anastasiia-khrus-29a180100/" target="_blank" rel="noopener" class="social-btn linkedin">
                        <i class="fab fa-linkedin"></i> LinkedIn
                    </a>
                    <a href="https://github.com/AnastasiiaKhru" target="_blank" rel="noopener" class="social-btn github">
                        <i class="fab fa-github"></i> GitHub
                    </a>
                    <a asp-controller="Home" asp-action="Resume" class="social-btn resume">
                        <i class="fas fa-file-alt"></i> View resume
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
