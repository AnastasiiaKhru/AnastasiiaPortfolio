@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Northline — Commercial & Residential Construction · WordPress Theme</title>
    <meta name="description" content="Modern WordPress construction theme. Project galleries, quote forms, ACF, Full Site Editing." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --ink: #0c0e10;
            --ink-soft: #2a2e33;
            --steel: #5a7d96;
            --amber: #d4a017;
            --amber-hot: #e8b42a;
            --paper: #f2f3f5;
            --white: #ffffff;
            --muted: #6b7280;
            --line: rgba(12,14,16,.1);
            --radius: 4px;
            --shadow: 0 12px 40px rgba(12,14,16,.12);
            --fd: 'Syne', system-ui, sans-serif;
            --fb: 'Outfit', system-ui, sans-serif;
            --ease: 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; scroll-padding-top: 88px; }
        body { font-family: var(--fb); color: var(--ink); line-height: 1.65; -webkit-font-smoothing: antialiased; background: var(--paper); }
        img { max-width: 100%; display: block; }
        a { color: inherit; text-decoration: none; }
        .wrap { max-width: 1180px; margin: 0 auto; padding: 0 1.5rem; }

        .wp-demo-badge {
            position: fixed; top: 0; right: 1rem; z-index: 300;
            padding: 0.4rem 0.75rem; background: #23282d; color: #fff;
            font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em;
            border-radius: 0 0 6px 6px; box-shadow: 0 2px 8px rgba(0,0,0,.15);
        }
        .wp-demo-badge i { margin-right: 0.35rem; color: #00a0d2; }

        .announce {
            background: var(--ink); color: #c8ccd0; text-align: center;
            padding: 0.55rem 1rem; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.04em;
        }
        .announce strong { color: var(--amber-hot); font-weight: 600; }

        header {
            position: sticky; top: 0; z-index: 200;
            background: rgba(12,14,16,.92);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,.06);
            transition: box-shadow var(--ease);
        }
        header.scrolled { box-shadow: 0 8px 32px rgba(0,0,0,.35); }
        .header-inner {
            max-width: 1180px; margin: 0 auto; padding: 0 1.5rem;
            display: flex; align-items: center; justify-content: space-between; height: 72px;
        }
        .logo {
            font-family: var(--fd); font-weight: 800; font-size: 1.35rem;
            color: #fff; letter-spacing: -0.03em; display: flex; align-items: center; gap: .45rem;
        }
        .logo-mark {
            width: 28px; height: 28px; background: var(--amber);
            clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
            display: inline-block;
        }
        .logo span { color: var(--amber); }
        nav ul { list-style: none; display: flex; gap: 2rem; }
        nav a { color: rgba(255,255,255,.72); font-weight: 500; font-size: 0.9rem; transition: color .2s; }
        nav a:hover, nav a.active { color: #fff; }
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
            border: none; border-radius: var(--radius); padding: 0.85rem 1.5rem;
            font-family: inherit; font-weight: 600; font-size: 0.9rem; cursor: pointer;
            transition: transform .25s, box-shadow .25s, background .25s;
        }
        .btn-amber { background: var(--amber); color: var(--ink); box-shadow: 0 4px 18px rgba(212,160,23,.35); }
        .btn-amber:hover { background: var(--amber-hot); transform: translateY(-2px); }
        .btn-ghost {
            background: transparent; color: #fff;
            border: 1px solid rgba(255,255,255,.28);
        }
        .btn-ghost:hover { border-color: #fff; background: rgba(255,255,255,.06); }
        .btn-ink { background: var(--ink); color: #fff; }
        .btn-ink:hover { background: var(--ink-soft); transform: translateY(-2px); }
        .nav-cta { padding: 0.65rem 1.15rem; font-size: 0.82rem; }
        .nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: .5rem; }
        .nav-toggle span { display: block; width: 22px; height: 2px; background: #fff; margin: 5px 0; }

        /* Hero — full bleed */
        .hero {
            position: relative; min-height: min(92vh, 820px);
            display: flex; align-items: flex-end;
            color: #fff; overflow: hidden;
        }
        .hero-bg {
            position: absolute; inset: 0;
            background:
                linear-gradient(180deg, rgba(12,14,16,.35) 0%, rgba(12,14,16,.55) 45%, rgba(12,14,16,.92) 100%),
                url('https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
            transform: scale(1.02);
            animation: heroDrift 18s ease-in-out infinite alternate;
        }
        @@keyframes heroDrift {
            from { transform: scale(1.02) translateY(0); }
            to { transform: scale(1.06) translateY(-1.5%); }
        }
        .hero-inner {
            position: relative; z-index: 2; width: 100%;
            padding: 0 1.5rem 4.5rem; max-width: 1180px; margin: 0 auto;
        }
        .hero-brand {
            font-family: var(--fd); font-size: clamp(2.8rem, 8vw, 5.5rem);
            font-weight: 800; letter-spacing: -0.04em; line-height: .95;
            margin-bottom: 1.25rem;
            opacity: 0; animation: rise .9s var(--ease) .15s forwards;
        }
        .hero-brand em { font-style: normal; color: var(--amber); }
        .hero h1 {
            font-family: var(--fd); font-size: clamp(1.35rem, 2.8vw, 1.85rem);
            font-weight: 600; letter-spacing: -0.02em; max-width: 28ch;
            line-height: 1.25; margin-bottom: .85rem;
            opacity: 0; animation: rise .9s var(--ease) .35s forwards;
        }
        .hero p {
            font-size: 1.05rem; font-weight: 300; color: rgba(255,255,255,.78);
            max-width: 42ch; margin-bottom: 1.75rem;
            opacity: 0; animation: rise .9s var(--ease) .5s forwards;
        }
        .hero-actions {
            display: flex; flex-wrap: wrap; gap: .85rem;
            opacity: 0; animation: rise .9s var(--ease) .65s forwards;
        }
        @@keyframes rise {
            from { opacity: 0; transform: translateY(22px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .hero-meta {
            position: absolute; right: 1.5rem; bottom: 4.5rem; z-index: 2;
            display: flex; gap: 2rem; text-align: right;
            opacity: 0; animation: rise .9s var(--ease) .8s forwards;
        }
        .hero-meta strong {
            display: block; font-family: var(--fd); font-size: 1.65rem; font-weight: 700;
            color: var(--amber); letter-spacing: -0.02em;
        }
        .hero-meta span { font-size: .75rem; color: rgba(255,255,255,.55); text-transform: uppercase; letter-spacing: .12em; }

        /* Sections */
        .section { padding: 5rem 0; }
        .section-label {
            display: block; font-size: .7rem; font-weight: 600;
            letter-spacing: .2em; text-transform: uppercase; color: var(--steel);
            margin-bottom: .75rem;
        }
        .section-title {
            font-family: var(--fd); font-size: clamp(1.75rem, 3.5vw, 2.4rem);
            font-weight: 700; letter-spacing: -0.03em; line-height: 1.15;
            margin-bottom: .75rem;
        }
        .section-lead { color: var(--muted); max-width: 48ch; font-size: 1.05rem; font-weight: 300; }
        .section-head { margin-bottom: 2.75rem; }

        /* Services */
        .services-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
        }
        .svc {
            background: var(--white); border: 1px solid var(--line);
            padding: 1.75rem 1.5rem; transition: transform var(--ease), box-shadow var(--ease);
        }
        .svc:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
        .svc-icon {
            width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;
            background: var(--ink); color: var(--amber); font-size: 1.15rem; margin-bottom: 1.15rem;
        }
        .svc h3 {
            font-family: var(--fd); font-size: 1.15rem; font-weight: 700;
            letter-spacing: -0.02em; margin-bottom: .5rem;
        }
        .svc p { font-size: .9rem; color: var(--muted); line-height: 1.55; }

        /* Projects */
        .projects { background: var(--ink); color: #fff; }
        .projects .section-label { color: var(--amber); }
        .projects .section-lead { color: rgba(255,255,255,.55); }
        .proj-grid {
            display: grid; grid-template-columns: 1.4fr 1fr; grid-template-rows: auto auto;
            gap: 1rem;
        }
        .proj {
            position: relative; overflow: hidden; min-height: 260px;
            background: #1a1d21;
        }
        .proj--tall { grid-row: span 2; min-height: 540px; }
        .proj img {
            width: 100%; height: 100%; object-fit: cover;
            transition: transform .7s var(--ease); opacity: .85;
        }
        .proj:hover img { transform: scale(1.05); opacity: 1; }
        .proj-info {
            position: absolute; left: 0; right: 0; bottom: 0;
            padding: 1.5rem; background: linear-gradient(transparent, rgba(12,14,16,.92));
        }
        .proj-info small {
            display: block; font-size: .65rem; letter-spacing: .16em;
            text-transform: uppercase; color: var(--amber); margin-bottom: .35rem;
        }
        .proj-info h3 {
            font-family: var(--fd); font-size: 1.25rem; font-weight: 700;
            letter-spacing: -0.02em;
        }

        /* Process */
        .process-row {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem;
            counter-reset: step;
        }
        .step {
            position: relative; padding-top: 1rem;
            border-top: 2px solid var(--ink);
        }
        .step::before {
            counter-increment: step;
            content: "0" counter(step);
            font-family: var(--fd); font-weight: 800; font-size: 2rem;
            color: var(--amber); letter-spacing: -0.04em;
            display: block; margin-bottom: .85rem; line-height: 1;
        }
        .step h3 {
            font-family: var(--fd); font-size: 1.05rem; font-weight: 700;
            margin-bottom: .4rem; letter-spacing: -0.02em;
        }
        .step p { font-size: .875rem; color: var(--muted); }

        /* Stats band */
        .stats {
            background: linear-gradient(135deg, #16191d 0%, #0c0e10 100%);
            color: #fff; padding: 3.5rem 0;
        }
        .stats-grid {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; text-align: center;
        }
        .stat strong {
            display: block; font-family: var(--fd); font-size: clamp(2rem, 4vw, 2.75rem);
            font-weight: 800; color: var(--amber); letter-spacing: -0.03em; line-height: 1;
            margin-bottom: .4rem;
        }
        .stat span { font-size: .8rem; color: rgba(255,255,255,.5); letter-spacing: .08em; text-transform: uppercase; }

        /* Why */
        .why-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;
        }
        .why-visual {
            position: relative; aspect-ratio: 4/5; overflow: hidden;
            background: #1a1d21;
        }
        .why-visual img { width: 100%; height: 100%; object-fit: cover; }
        .why-badge {
            position: absolute; left: 1.25rem; bottom: 1.25rem;
            background: var(--amber); color: var(--ink);
            padding: 1rem 1.25rem; font-family: var(--fd); font-weight: 700;
            font-size: .95rem; letter-spacing: -0.01em; max-width: 200px; line-height: 1.3;
        }
        .why-list { list-style: none; margin-top: 1.75rem; }
        .why-list li {
            display: flex; gap: .85rem; padding: 1rem 0;
            border-bottom: 1px solid var(--line); font-size: .95rem;
        }
        .why-list i { color: var(--amber); margin-top: .2rem; flex-shrink: 0; }

        /* Quote CTA */
        .quote {
            position: relative; overflow: hidden; color: #fff;
            background: var(--ink);
            padding: 5rem 0;
        }
        .quote::before {
            content: ''; position: absolute; inset: 0;
            background:
                linear-gradient(90deg, rgba(12,14,16,.94) 0%, rgba(12,14,16,.75) 55%, rgba(12,14,16,.55) 100%),
                url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1600&q=80') center/cover;
        }
        .quote .wrap { position: relative; z-index: 1; max-width: 560px; }
        .quote h2 {
            font-family: var(--fd); font-size: clamp(1.85rem, 4vw, 2.6rem);
            font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
            margin-bottom: .85rem;
        }
        .quote p { color: rgba(255,255,255,.7); margin-bottom: 1.75rem; font-weight: 300; }
        .quote-form {
            display: grid; gap: .75rem;
        }
        .quote-form input, .quote-form select, .quote-form textarea {
            width: 100%; padding: .9rem 1rem; border: 1px solid rgba(255,255,255,.15);
            background: rgba(255,255,255,.06); color: #fff; font-family: inherit; font-size: .9rem;
            border-radius: var(--radius);
        }
        .quote-form input::placeholder, .quote-form textarea::placeholder { color: rgba(255,255,255,.4); }
        .quote-form select option { color: var(--ink); }
        .quote-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }

        /* Contact / footer */
        footer {
            background: #08090a; color: rgba(255,255,255,.55);
            padding: 3.5rem 0 2rem; font-size: .875rem;
        }
        .foot-grid {
            display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2rem;
            margin-bottom: 2.5rem;
        }
        .foot-brand {
            font-family: var(--fd); font-size: 1.35rem; font-weight: 800;
            color: #fff; letter-spacing: -0.03em; margin-bottom: .75rem;
        }
        .foot-brand span { color: var(--amber); }
        footer h4 {
            font-family: var(--fd); color: #fff; font-size: .85rem;
            letter-spacing: .06em; text-transform: uppercase; margin-bottom: 1rem;
        }
        footer ul { list-style: none; }
        footer li { margin-bottom: .45rem; }
        footer a:hover { color: var(--amber); }
        .foot-bottom {
            border-top: 1px solid rgba(255,255,255,.08);
            padding-top: 1.5rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .75rem;
            font-size: .75rem;
        }
        .wp-credit { color: rgba(255,255,255,.35); }
        .wp-credit i { color: #00a0d2; margin-right: .25rem; }

        .back-top {
            position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 150;
            width: 44px; height: 44px; border: none; border-radius: 50%;
            background: var(--amber); color: var(--ink); cursor: pointer;
            box-shadow: var(--shadow); opacity: 0; pointer-events: none;
            transition: opacity .3s, transform .3s; font-size: 1rem;
        }
        .back-top.show { opacity: 1; pointer-events: auto; }
        .back-top:hover { transform: translateY(-3px); }

        .reveal {
            opacity: 0; transform: translateY(24px);
            transition: opacity .7s var(--ease), transform .7s var(--ease);
        }
        .reveal.visible { opacity: 1; transform: none; }

        @@media (max-width: 960px) {
            .services-grid, .process-row, .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .proj-grid { grid-template-columns: 1fr; }
            .proj--tall { grid-row: auto; min-height: 320px; }
            .why-grid, .foot-grid { grid-template-columns: 1fr; }
            .hero-meta { display: none; }
            nav ul { display: none; }
            nav ul.show {
                display: flex; flex-direction: column; position: absolute;
                top: 72px; left: 0; right: 0; background: var(--ink);
                padding: 1.25rem 1.5rem 1.5rem; gap: 1rem;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }
            .nav-toggle { display: block; }
            .header-inner .nav-cta { display: none; }
        }
        @@media (max-width: 600px) {
            .services-grid, .process-row, .stats-grid, .quote-row { grid-template-columns: 1fr; }
            .hero { min-height: 85vh; }
            .hero-inner { padding-bottom: 3rem; }
            .section { padding: 3.5rem 0; }
        }
    </style>
</head>
<body>
    <div class="wp-demo-badge"><i class="fab fa-wordpress"></i> WP Theme Demo</div>
    <div class="announce">Licensed &amp; insured · Serving the GTA &amp; Southern Ontario · <strong>Free site assessment this month</strong></div>

    <header id="siteHeader">
        <div class="header-inner">
            <a href="#" class="logo"><span class="logo-mark"></span>North<span>line</span></a>
            <nav>
                <ul id="navMenu">
                    <li><a href="#services">Services</a></li>
                    <li><a href="#projects">Projects</a></li>
                    <li><a href="#process">Process</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a href="#quote">Contact</a></li>
                </ul>
            </nav>
            <a href="#quote" class="btn btn-amber nav-cta">Get a quote</a>
            <button class="nav-toggle" type="button" aria-label="Menu" onclick="document.getElementById('navMenu').classList.toggle('show')">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <section class="hero">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="hero-inner">
            <div class="hero-brand">North<em>line</em></div>
            <h1>Build with precision. Deliver with pride.</h1>
            <p>Commercial and residential construction for owners who expect clarity, craftsmanship, and on-time delivery.</p>
            <div class="hero-actions">
                <a href="#quote" class="btn btn-amber">Request a project quote</a>
                <a href="#projects" class="btn btn-ghost">View recent builds</a>
            </div>
        </div>
        <div class="hero-meta">
            <div><strong>180+</strong><span>Projects</span></div>
            <div><strong>22</strong><span>Years</span></div>
            <div><strong>98%</strong><span>On time</span></div>
        </div>
    </section>

    <section class="section" id="services">
        <div class="wrap">
            <div class="section-head reveal">
                <span class="section-label">What we build</span>
                <h2 class="section-title">Full-service construction, end to end</h2>
                <p class="section-lead">From shell and core to finish packages — one accountable team across every phase.</p>
            </div>
            <div class="services-grid">
                <article class="svc reveal">
                    <div class="svc-icon"><i class="fas fa-building"></i></div>
                    <h3>Commercial builds</h3>
                    <p>Offices, retail, light industrial, and tenant improvements with schedule-driven delivery.</p>
                </article>
                <article class="svc reveal">
                    <div class="svc-icon"><i class="fas fa-home"></i></div>
                    <h3>Custom residences</h3>
                    <p>New homes and major renovations with architectural detailing and clean site management.</p>
                </article>
                <article class="svc reveal">
                    <div class="svc-icon"><i class="fas fa-drafting-compass"></i></div>
                    <h3>Design–build</h3>
                    <p>Single-point accountability from concept through occupancy — fewer gaps, fewer surprises.</p>
                </article>
                <article class="svc reveal">
                    <div class="svc-icon"><i class="fas fa-hard-hat"></i></div>
                    <h3>Renovations</h3>
                    <p>Structural upgrades, interiors, and phased work for occupied commercial spaces.</p>
                </article>
                <article class="svc reveal">
                    <div class="svc-icon"><i class="fas fa-clipboard-check"></i></div>
                    <h3>Project management</h3>
                    <p>Budgets, permits, trades coordination, and weekly owner reporting you can trust.</p>
                </article>
                <article class="svc reveal">
                    <div class="svc-icon"><i class="fas fa-warehouse"></i></div>
                    <h3>Industrial fit-outs</h3>
                    <p>Warehouses, workshops, and production floors built for durability and workflow.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="section projects" id="projects">
        <div class="wrap">
            <div class="section-head reveal">
                <span class="section-label">Selected work</span>
                <h2 class="section-title">Projects that speak for themselves</h2>
                <p class="section-lead">A sample of recent Northline builds — real sites, real schedules, real finishes.</p>
            </div>
            <div class="proj-grid">
                <article class="proj proj--tall reveal">
                    <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1000&q=80" alt="Downtown office tower" loading="lazy" />
                    <div class="proj-info">
                        <small>Commercial · Toronto</small>
                        <h3>Harbourview Offices</h3>
                    </div>
                </article>
                <article class="proj reveal">
                    <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80" alt="Modern residence" loading="lazy" />
                    <div class="proj-info">
                        <small>Residential · Oakville</small>
                        <h3>Cedar Ridge Residence</h3>
                    </div>
                </article>
                <article class="proj reveal">
                    <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=800&q=80" alt="Industrial facility" loading="lazy" />
                    <div class="proj-info">
                        <small>Industrial · Mississauga</small>
                        <h3>Westline Logistics Hub</h3>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="section" id="process">
        <div class="wrap">
            <div class="section-head reveal">
                <span class="section-label">How we work</span>
                <h2 class="section-title">A clear process from day one</h2>
                <p class="section-lead">No mystery phases. You always know what’s next, what’s costing what, and who’s responsible.</p>
            </div>
            <div class="process-row">
                <div class="step reveal">
                    <h3>Discover</h3>
                    <p>Site walk, scope alignment, and a transparent preliminary budget.</p>
                </div>
                <div class="step reveal">
                    <h3>Plan</h3>
                    <p>Drawings, permits, procurement, and a locked construction schedule.</p>
                </div>
                <div class="step reveal">
                    <h3>Build</h3>
                    <p>Daily site leadership, QC checkpoints, and weekly owner updates.</p>
                </div>
                <div class="step reveal">
                    <h3>Hand over</h3>
                    <p>Final walkthrough, documentation package, and warranty support.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="stats">
        <div class="wrap">
            <div class="stats-grid reveal">
