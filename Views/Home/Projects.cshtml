@{
    ViewData["Title"] = "Projects";
}
@section Styles {
<style>
    .page-inner--projects {
        position: relative;
        background:
            radial-gradient(circle at 12% 15%, rgba(148, 163, 184, 0.1), transparent 40%),
            radial-gradient(circle at 88% 5%, rgba(203, 213, 225, 0.11), transparent 36%),
            linear-gradient(160deg, #f8fafc 0%, #f8f7f4 52%, #f7f5f0 100%);
    }

    .page-inner--projects::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0));
        z-index: 0;
    }

    .page-inner--projects > * {
        position: relative;
        z-index: 1;
    }

    .page-inner--projects .page-header__title {
        letter-spacing: -0.03em;
    }

    .page-inner--projects .page-header__lead {
        max-width: 760px;
        color: #5b4f42;
    }

    .page-inner--projects .projects-count {
        color: #6b5d4d;
        margin-bottom: 0.75rem;
    }

    .page-inner--projects .projects-filter {
        top: 74px;
        padding: .9rem;
        margin-bottom: 2rem;
        border-radius: 1rem;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: rgba(255, 255, 255, 0.78);
        backdrop-filter: blur(10px);
        box-shadow: 0 12px 36px rgba(15, 23, 42, 0.08);
    }

    .page-inner--projects .filter-btn {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(191, 161, 106, 0.32);
        color: #4b3f34;
        font-weight: 600;
        border-radius: 999px;
    }

    .page-inner--projects .filter-btn:hover {
        transform: translateY(-1px);
        border-color: rgba(191, 161, 106, 0.62);
        box-shadow: 0 6px 16px rgba(191, 161, 106, 0.22);
    }

    .page-inner--projects .filter-btn.active {
        color: #1f2937;
        border-color: transparent;
        background: linear-gradient(135deg, #fef3c7 0%, #fcd34d 50%, #f59e0b 100%);
        box-shadow: 0 10px 22px rgba(245, 158, 11, 0.3);
    }

    .page-inner--projects .projects-showcase {
        margin-top: -1.5rem;
        padding-top: 3.75rem;
        border-radius: 2.5rem 2.5rem 0 0;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(248, 250, 252, 0.94) 100%);
        box-shadow: 0 -18px 48px rgba(15, 23, 42, 0.08);
        position: relative;
        z-index: 2;
    }

    .page-inner--projects .projects-grid {
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fill, minmax(335px, 1fr));
    }

    .page-inner--projects .project-card-modern {
        border: 1px solid rgba(148, 163, 184, 0.2);
        background: linear-gradient(160deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.78));
        box-shadow: 0 12px 36px rgba(15, 23, 42, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(12px);
        border-radius: 1.3rem;
        transition: transform .3s ease, box-shadow .3s ease, border-color .25s ease;
    }

    .page-inner--projects .project-card-modern::before {
        width: 5px;
        background: linear-gradient(180deg, #f59e0b 0%, #fbbf24 100%);
        opacity: 1;
    }

    .page-inner--projects .project-card-modern:hover {
        transform: translateY(-8px);
        border-color: rgba(191, 161, 106, 0.36);
        box-shadow: 0 22px 48px rgba(15, 23, 42, 0.12), 0 8px 18px rgba(191, 161, 106, 0.2);
    }

    .page-inner--projects .project-card__title {
        font-size: clamp(1.35rem, 1.18rem + 0.55vw, 1.7rem);
        letter-spacing: -0.03em;
    }

    .page-inner--projects .project-card__summary {
        color: #0f172a;
        font-weight: 600;
    }

    .page-inner--projects .project-card__desc {
        color: #5b4f42;
        line-height: 1.7;
    }

    .page-inner--projects .project-card__preview {
        border: 1px solid rgba(148, 163, 184, 0.22);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
        border-radius: 1rem;
    }

    .page-inner--projects .projects-scroll-hint {
        color: #7a6650;
        margin-bottom: 2rem;
    }

    @@media (max-width: 768px) {
        .page-inner--projects .projects-filter {
            top: 62px;
            padding: 0.7rem;
        }
    }
</style>
}
<div class="page-inner page-inner--projects">
    <header class="page-header">
        <div class="container">
            <p class="page-header__label" data-motion-before-typewriter>Portfolio</p>
            <h1 class="page-header__title text-gradient-motion" data-typewriter data-typewriter-text="Projects &amp; Design Showcase" data-typewriter-speed="50"></h1>
            <p class="page-header__lead" data-motion-after-typewriter>Programming and design work: e-commerce, web apps, games, and creative marketing projects. Filter by category to explore.</p>
        </div>
    </header>

    <section class="projects-showcase">
        <div class="container container--projects-wide">
            <div class="project-switcher reveal-ready" id="projectSwitcher">
                <p class="project-switcher__label">Featured work</p>
                <div class="project-switcher__layout">
                    <div class="project-switcher__tabs" role="tablist" aria-label="Featured project categories">
                        <button type="button" class="project-switcher__tab is-active" role="tab" aria-selected="true" data-switcher="ecommerce">E-Commerce · ONE80</button>
                        <button type="button" class="project-switcher__tab" role="tab" aria-selected="false" data-switcher="wordpress">WordPress · NurtureWell</button>
                        <button type="button" class="project-switcher__tab" role="tab" aria-selected="false" data-switcher="crm">CRM · FitHub</button>
                        <button type="button" class="project-switcher__tab" role="tab" aria-selected="false" data-switcher="game">Games · PlayZone</button>
                    </div>
                    <div class="project-switcher__preview" id="projectSwitcherPreview">
                        <div class="project-switcher__slide is-active" data-switcher-panel="ecommerce">
                            <img src="https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=1100&q=85" alt="ONE80 Revolution Shopify storefront" loading="lazy" />
                            <div class="project-switcher__slide-content">
                                <h3>ONE80 Revolution</h3>
                                <p>Shopify storefront for a precision training water bottle — product UX, checkout setup, and post-launch optimization.</p>
                                <a href="https://www.one80revolution.com/pages/contact" class="project-switcher__slide-link" target="_blank" rel="noopener">View site <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </div>
                        <div class="project-switcher__slide" data-switcher-panel="wordpress">
                            <img src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=1100&q=85" alt="NurtureWell WordPress wellness theme" loading="lazy" />
                            <div class="project-switcher__slide-content">
                                <h3>NurtureWell</h3>
                                <p>Wellness WordPress theme with WooCommerce, appointments, ACF, and pro-grade block patterns.</p>
                                <a asp-controller="Home" asp-action="DemoFrame" asp-route-name="WPWellnessDemo" class="project-switcher__slide-link" target="_blank" rel="noopener">Open demo <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </div>
                        <div class="project-switcher__slide" data-switcher-panel="crm">
                            <img src="/images/project-crm-og.png" alt="FitHub CRM gym management dashboard" loading="lazy" />
                            <div class="project-switcher__slide-content">
                                <h3>FitHub CRM</h3>
                                <p>Gym membership CRM with dashboards, member tiers, activity feeds, and payment workflows.</p>
                                <a asp-controller="Home" asp-action="DemoFrame" asp-route-name="GymCrmDemo" class="project-switcher__slide-link" target="_blank" rel="noopener">Open demo <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </div>
                        <div class="project-switcher__slide" data-switcher-panel="game">
                            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1100&q=80" alt="PlayZone Snake game preview" loading="lazy" />
                            <div class="project-switcher__slide-content">
                                <h3>PlayZone — Snake</h3>
                                <p>Playable arcade game with leaderboard, keyboard/touch controls, and MongoDB-backed scores.</p>
                                <a href="/PlayZone/Snake" class="project-switcher__slide-link" target="_blank" rel="noopener">Play now <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="projects-filter" role="tablist">
                <button class="filter-btn active" data-filter="all" aria-selected="true">All</button>
                <button class="filter-btn" data-filter="ecommerce">E-Commerce</button>
                <button class="filter-btn" data-filter="marketing">Marketing</button>
                <button class="filter-btn" data-filter="crm">CRM</button>
                <button class="filter-btn" data-filter="game">Games</button>
                <button class="filter-btn" data-filter="design">Content Creation</button>
                <button class="filter-btn" data-filter="fullstack">Full-Stack</button>
            </div>

            <p class="projects-scroll-hint" aria-hidden="true">
                <i class="fas fa-chevron-down"></i> Scroll to explore
            </p>

            <partial name="_ProjectsPartial" />
        </div>
    </section>
</div>
