<style>
    .card {
        border: none;
        box-shadow: var(--shadow);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .timeline-item {
        position: relative;
        padding-left: 1.5rem;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background-color: var(--pepper, #0f172a);
    }

    .timeline-item::after {
        content: '';
        position: absolute;
        left: -4px;
        top: 0;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--pepper, #0f172a);
    }

    .badge {
        font-weight: 500;
    }

    .work-experience-section {
        margin: 20px auto;
        padding: 20px;
        max-width: 800px;
        background-color: rgba(255, 255, 255, 0.8);
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .lead.text-secondary,
    .text-secondary {
        color: #5b6472;
    }

    .bg-primary {
        background-color: #2B2B2B;
        color: #FFFFFF;
    }
</style>
