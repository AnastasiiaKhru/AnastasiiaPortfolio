@model AnastasiiaPortfolio.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "page-home";
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap');

        /* Modern premium hero */

        .page-home .hero-section {
            margin-top: calc(-1 * var(--navbar-height, 80px));
            padding-top: calc(var(--navbar-height, 80px) + clamp(2.75rem, 7vh, 4.75rem));
            padding-bottom: clamp(1rem, 2vh, 1.5rem);
            min-height: auto;
        }

        .page-home .hero-section .container {
            margin-top: clamp(1rem, 3vh, 2rem);
        }

        .hero-section {
            padding: clamp(0.9rem, 2vh, 1.5rem) 0;
            margin-bottom: 0;
            position: relative;
            min-height: auto;
            display: flex;
            align-items: center;
            overflow: hidden;
            background:
                linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(248, 250, 252, 0.35)),
                radial-gradient(circle at 16% 20%, rgba(251, 191, 36, 0.1), transparent 42%),
                radial-gradient(circle at 86% 15%, rgba(251, 146, 60, 0.08), transparent 38%),
                url('/images/hero-home-bg.png');
            background-size: auto, auto, auto, cover;
            background-position: center, 16% 20%, 86% 15%, center;
            background-repeat: no-repeat;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            inset: auto -120px -110px auto;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.28), rgba(99, 102, 241, 0));
            filter: blur(16px);
            z-index: 1;
            pointer-events: none;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 20% 24%, rgba(251, 191, 36, 0.06), transparent 45%),
                linear-gradient(112deg, rgba(248, 250, 252, 0.36), rgba(241, 245, 249, 0.2));
            backdrop-filter: blur(2px);
            pointer-events: none;
            z-index: 1;
        }

        .hero-section .container {
            position: relative;
            z-index: 2;
            background: rgba(255, 255, 255, 0.62);
            border-radius: 32px;
            border: 1px solid rgba(255, 255, 255, 0.56);
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.16), 0 0 0 1px rgba(255, 255, 255, 0.55) inset;
            backdrop-filter: blur(18px);
            padding: clamp(1.1rem, 1.8vw, 2rem);
        }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.35rem 0.9rem;
            border-radius: 999px;
            color: #0f172a;
            border: 1px solid rgba(191, 161, 106, 0.45);
            background: rgba(255, 250, 240, 0.78);
            font-size: 0.85rem;
            margin-bottom: 0.9rem;
        }

        .hero-kicker:not([data-motion-before-typewriter]) {
            animation: heroFadeUp 0.7s ease both;
        }

        .hero-headline {
            font-size: clamp(2rem, 1.4rem + 2.4vw, 3.3rem);
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.04em;
            margin-bottom: 1rem;
            text-shadow: 0 8px 20px rgba(148, 163, 184, 0.22);
            line-height: 1.18;
        }

        .hero-headline__line {
            display: block;
        }

        .hero-headline__line--accent {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            column-gap: 0.5em;
            row-gap: 0.15em;
        }

        .hero-headline__suffix {
            white-space: nowrap;
            margin-left: 0.12em;
        }

        .hero-headline:not(.motion-before-typewriter) {
            animation: heroFadeUp 0.8s ease 0.08s both;
        }

        .hero-rotate {
            display: inline-grid;
            vertical-align: baseline;
            height: 1.15em;
            overflow: hidden;
            color: #b45309;
            flex: 0 0 auto;
            margin-right: 0.2em;
            padding-right: 0.08em;
        }

        .hero-rotate__word {
            grid-area: 1 / 1;
            align-self: end;
            white-space: nowrap;
            opacity: 0;
            transform: translateY(110%);
            transition:
                opacity 0.55s var(--ease-motion, cubic-bezier(0.16, 1, 0.3, 1)),
                transform 0.55s var(--ease-motion, cubic-bezier(0.16, 1, 0.3, 1));
        }

        .hero-rotate__word.is-active {
            opacity: 1;
            transform: translateY(0);
        }

        .hero-rotate__word.is-exiting {
            opacity: 0;
            transform: translateY(-110%);
        }

        [data-motion-after-typewriter] {
            opacity: 0;
            transform: translateY(20px);
        }

        .hero-section .lead {
            font-size: var(--font-size-lg);
            color: #1e293b;
            line-height: 1.72;
            max-width: 560px;
            text-shadow: none;
        }

        .hero-section .lead:not([data-motion-after-typewriter]) {
            animation: heroFadeUp 0.85s ease 0.14s both;
        }

        .hero-image {
            position: relative;
            overflow: visible;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .hero-portrait-block {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: min(360px, 88%);
        }

        .hero-portrait-caption {
            width: 100%;
            margin-top: 1rem;
            padding: 0 0.35rem;
            text-align: center;
        }

        .hero-portrait-caption::before {
            content: '';
            display: block;
            width: 3.25rem;
            height: 3px;
            margin: 0 auto 0.85rem;
            border-radius: 999px;
            background: linear-gradient(90deg, transparent, #f59e0b 20%, #fbbf24 50%, #f59e0b 80%, transparent);
            box-shadow: 0 0 12px rgba(245, 158, 11, 0.45);
        }

        .hero-portrait-signature {
            margin: 0;
            font-family: 'Great Vibes', cursive;
            font-size: clamp(2.15rem, 1.5rem + 2.6vw, 3rem);
            font-weight: 400;
            line-height: 1.05;
            letter-spacing: 0.01em;
            text-align: center;
            color: #0f172a;
        }

        .hero-portrait-signature.is-signature-typing {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: none !important;
            -webkit-text-fill-color: #0f172a !important;
            color: #0f172a !important;
            animation: none !important;
        }

        .hero-portrait-signature .signature-type-line {
            display: block;
            min-height: 1.05em;
            white-space: nowrap;
            color: #0f172a;
            -webkit-text-fill-color: #0f172a;
            font-family: 'Great Vibes', cursive;
        }

        .hero-portrait-signature .signature-type-output {
            color: #0f172a;
            -webkit-text-fill-color: #0f172a;
            background: none;
        }

        .hero-portrait-signature .signature-type-line .typewriter-cursor {
            display: inline-block;
            width: 2px;
            height: 0.75em;
            margin-left: 2px;
            vertical-align: -0.05em;
            border-radius: 2px;
            -webkit-text-fill-color: initial;
            color: initial;
            background: linear-gradient(180deg, #d97706, #fbbf24);
            -webkit-background-clip: border-box;
            background-clip: border-box;
            animation: typewriterBlink 0.72s step-end infinite;
        }

        .hero-portrait-role {
            margin: 0.45rem 0 0;
            font-size: clamp(0.78rem, 0.72rem + 0.25vw, 0.9rem);
            font-weight: 600;
            color: #64748b;
            letter-spacing: 0.03em;
            line-height: 1.45;
        }

        .hero-portrait-role[data-motion-after-signature] {
            opacity: 0;
            transform: translateY(10px);
        }

        .hero-portrait-role[data-motion-after-signature].motion-after-signature {
            opacity: 1;
            transform: none;
            transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .hero-portrait {
            position: relative;
            width: 100%;
            border-radius: 30px;
            overflow: hidden;
            aspect-ratio: 4/5;
            border: none;
            box-shadow: 0 30px 70px -20px rgba(2, 6, 23, 0.88);
            transform: perspective(1100px) rotateY(-8deg) rotateX(2deg);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
            background: #f3eeea;
            animation: heroFadeUp 0.9s ease 0.22s both;
        }

        .hero-portrait:hover {
            transform: perspective(1100px) rotateY(-3deg) rotateX(0deg) translateY(-2px);
            box-shadow: 0 38px 92px -16px rgba(2, 6, 23, 0.95);
        }

        .hero-portrait img,
        .hero-portrait-img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100% !important;
            max-width: none;
            object-fit: cover;
            object-position: center 12%;
            transform: scale(1.04);
            transform-origin: center center;
            display: block;
        }

        .hero-portrait-glow {
            position: absolute;
            inset: auto -25% -20% auto;
            width: 75%;
            aspect-ratio: 1/1;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.24), rgba(245, 158, 11, 0));
            filter: blur(12px);
            pointer-events: none;
            z-index: -1;
            animation: heroGlowPulse 4s ease-in-out infinite;
        }

        .hero-section .hero-btn-group {
            margin-top: 1.1rem;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.65rem;
        }

        .hero-section .hero-btn-group:not([data-motion-after-typewriter]) {
            animation: heroFadeUp 0.95s ease 0.28s both;
        }

        .hero-section .hero-btn-group .btn {
            min-height: 44px;
            border-radius: 0.85rem;
            font-size: 0.95rem;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease;
        }

        .hero-section .hero-btn-group .btn-primary {
            background: linear-gradient(135deg, #fde68a 0%, #fcd34d 45%, #f59e0b 100%);
            color: #1f2937;
            border: none;
            box-shadow: 0 14px 26px rgba(245, 158, 11, 0.32);
        }
        .hero-section .hero-btn-group .btn-primary:hover {
            background: linear-gradient(135deg, #fef3c7 0%, #fcd34d 55%, #f59e0b 100%);
            color: #111827;
            transform: translateY(-2px);
        }
        .hero-section .hero-btn-group .btn-outline-primary {
            background: rgba(255, 255, 255, 0.72);
            color: #0f172a;
            border: 1px solid rgba(148, 163, 184, 0.45);
        }
        .hero-section .hero-btn-group .btn-outline-primary:hover {
            background: rgba(255, 248, 230, 0.95);
            color: #020617;
            border-color: rgba(191, 161, 106, 0.56);
        }
        .hero-section .hero-btn-group .btn-secondary {
            background: rgba(255, 255, 255, 0.72);
            color: #0f172a;
            border: 1px solid rgba(148, 163, 184, 0.45);
        }
        .hero-section .hero-btn-group .btn-secondary:hover {
            background: rgba(255, 248, 230, 0.95);
            color: #020617;
            border-color: rgba(191, 161, 106, 0.56);
        }

        @@keyframes heroFadeUp {
            from {
                opacity: 0;
                transform: translateY(14px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes heroGlowPulse {
            0%, 100% { opacity: .75; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.08); }
        }

        @@media (min-width: 769px) {
            .hero-section .row {
                --bs-gutter-x: 1.1rem;
            }
        }

        @@media (max-width: 1200px) and (min-width: 769px) {
            .hero-section {
                min-height: auto;
                padding: 1rem 0;
            }
            .hero-section .container {
                padding: 1.05rem;
                border-radius: 20px;
            }
            .hero-section .row {
                row-gap: 0.9rem;
                justify-content: center;
            }
            .hero-section .col-md-7,
            .hero-section .col-md-5 {
                flex: 0 0 100%;
                max-width: 100%;
            }
            .hero-section .col-md-7 {
                text-align: center;
            }
            .hero-kicker {
                margin-left: auto;
                margin-right: auto;
            }
            .hero-section .display-4 {
                font-size: clamp(1.7rem, 1.1rem + 1.35vw, 2.2rem);
                margin-bottom: 0.65rem;
                margin-left: auto;
                margin-right: auto;
                max-width: 22ch;
            }
            .hero-section .lead {
                font-size: 0.98rem;
                line-height: 1.55;
                max-width: 58ch;
                margin-left: auto;
                margin-right: auto;
            }
            .hero-section .hero-btn-group {
                margin-top: 0.75rem;
                gap: 0.55rem;
                grid-template-columns: 1fr;
                max-width: 700px;
                margin-left: auto;
                margin-right: auto;
            }
            .hero-image {
                max-width: 280px;
                margin: 0.35rem auto 0;
            }
            .hero-portrait-block {
                width: 100%;
            }
            .hero-portrait {
                width: 100%;
            }
            .hero-section .hero-btn-group .btn {
                max-width: 700px;
            }
        }

        @@media (max-width: 768px) {
            .hero-section { min-height: auto; padding: var(--spacing-6) 0; }
            .hero-section .container { padding: var(--spacing-5) var(--spacing-4); }
            .hero-section .hero-headline { font-size: clamp(1.5rem, 4vw, 2rem); }
            .hero-section .lead { font-size: var(--font-size-base); }
            .hero-image { max-width: 300px; margin: 0.5rem auto 0; }
            .hero-portrait-block {
                width: 100%;
            }
            .hero-portrait-signature {
                font-size: clamp(1.95rem, 1.45rem + 2.2vw, 2.5rem);
            }
            .hero-portrait,
            .hero-portrait:hover { transform: none; }
            .hero-section .hero-btn-group {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-height: 820px) and (min-width: 769px) {
            .hero-section {
                min-height: auto;
                padding: .75rem 0;
            }
            .hero-section .container {
                padding: 1rem;
            }
            .hero-section .hero-headline {
                font-size: clamp(1.8rem, 1.2rem + 1.8vw, 2.7rem);
                margin-bottom: .6rem;
            }
            .hero-section .lead {
                margin-bottom: .55rem;
                line-height: 1.58;
            }
            .hero-portrait-block {
                width: min(300px, 82%);
            }
            .hero-portrait {
                width: 100%;
            }
        }
    </style>
}

<div id="home" class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 col-md-7 order-lg-1">
                <div class="hero-kicker" data-motion-before-typewriter>Available for hire · 2026</div>
                <h1 class="display-4 hero-headline" data-motion-before-typewriter>
                    <span class="hero-headline__line">Building elegant</span>
                    <span class="hero-headline__line hero-headline__line--accent">
                        <span class="hero-rotate" data-rotate-words="digital experiences|Shopify storefronts|web applications|high-performance sites" aria-live="polite">
                            <span class="hero-rotate__word is-active">digital experiences</span>
                        </span><span class="hero-headline__suffix">that perform.</span>
                    </span>
                </h1>
                <p class="lead mb-0" data-motion-after-typewriter>Full-stack developer with 5+ years building websites, Shopify stores, apps, and brand experiences — from idea to launch.</p>
                <div class="hero-btn-group" data-motion-after-typewriter>
                    <a asp-controller="Home" asp-action="Projects" class="btn btn-primary">
                        <i class="fas fa-code"></i>View My Work
                    </a>
                    <a asp-controller="Home" asp-action="Resume" class="btn btn-secondary">
                        <i class="fas fa-file-alt"></i>View Resume
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary">
                        <i class="fas fa-envelope"></i>Contact Me
                    </a>
                </div>
            </div>
            <div class="col-lg-5 col-md-5 order-lg-2 mt-3 mt-md-0" data-motion-float>
                <div class="hero-image">
                    <div class="hero-portrait-block">
                        <div class="hero-portrait" role="img" aria-label="Portrait photo of Anastasiia">
                            <img src="/images/hero-image.png?v=2" alt="Anastasiia portrait photo" class="hero-portrait-img" data-skip-global-img>
                        </div>
                        <div class="hero-portrait-caption">
                            <p class="hero-portrait-signature"
                               data-signature-typewriter
                               data-signature-first="Anastasiia"
                               data-signature-last="Khrustaleva"
                               data-typewriter-speed="78"
                               data-typewriter-delay="400"
                               aria-label="Anastasiia Khrustaleva"></p>
                            <p class="hero-portrait-role" data-motion-after-signature>Software Developer · Web &amp; Product Designer</p>
                        </div>
                    </div>
                    <div class="hero-portrait-glow" aria-hidden="true"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="story-scroll story-scroll--after-hero" id="process" aria-label="How I work">
    <div class="container">
        <div class="story-scroll__inner">
            <div class="story-scroll__visual-wrap">
                <div class="story-scroll__visual" id="storyVisual">
                    <div class="story-scroll__panel is-active" data-story-panel="design">
                        <img src="https://images.unsplash.com/photo-1561070791-2526d30994b5?auto=format&fit=crop&w=900&q=80" alt="UI design workspace" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 01</p>
                            <p class="story-scroll__panel-title">Strategy, UX &amp; visual direction</p>
                        </div>
                    </div>
                    <div class="story-scroll__panel" data-story-panel="build">
                        <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=900&q=80" alt="Development on laptop" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 02</p>
                            <p class="story-scroll__panel-title">Development that ships clean</p>
                        </div>
                    </div>
                    <div class="story-scroll__panel" data-story-panel="launch">
                        <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=900&q=80" alt="E-commerce checkout experience" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 03</p>
                            <p class="story-scroll__panel-title">Deploy, measure &amp; improve</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="story-scroll__steps" role="list">
                <article class="story-step is-active" data-story-step="design" role="listitem" tabindex="0">
                    <p class="story-step__num">01 — Design</p>
                    <h3>Strategy, UX, and visual direction</h3>
                    <p>Page structure, user flows, and branded interfaces — from wireframes to polished UI — so every project starts with clarity and conversion in mind.</p>
                </article>
                <article class="story-step" data-story-step="build" role="listitem" tabindex="0">
                    <p class="story-step__num">02 — Build</p>
                    <h3>Development that ships clean</h3>
                    <p>ASP.NET Core, JavaScript, WordPress, Shopify, APIs, and databases — responsive, accessible, and ready for real users and real traffic.</p>
                </article>
                <article class="story-step" data-story-step="launch" role="listitem" tabindex="0">
                    <p class="story-step__num">03 — Launch</p>
                    <h3>Deploy, measure, improve</h3>
                    <p>Hosting, SEO, performance tuning, and post-launch updates — so the site stays fast, findable, and easy to grow after go-live.</p>
                </article>
            </div>
        </div>

        <article class="home-case home-case--after-process" aria-labelledby="home-case-one80-title">
            <div class="home-case__body">
                <p class="home-case__eyebrow">Featured Shopify work</p>
                <h3 class="home-case__title" id="home-case-one80-title">ONE80 Revolution</h3>
                <p class="home-case__lead">Precision hydration brand storefront — product pages, mobile UX, checkout setup, redirects, and post-launch merchant support.</p>
                <ul class="home-case__points">
                    <li><strong>Problem</strong> Make a technical product feel simple to buy on mobile.</li>
                    <li><strong>Approach</strong> Design the purchase path, then ship it in Shopify theme code.</li>
                    <li><strong>Result</strong> Live storefront with clearer PDPs and ongoing updates.</li>
                </ul>
                <div class="home-case__stack" aria-label="Stack">
                    <span>Shopify</span><span>Liquid</span><span>JavaScript</span><span>CSS</span><span>Checkout UX</span>
                </div>
                <a asp-controller="Home" asp-action="Projects" class="home-case__link">See all projects <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="home-case__media">
                <img class="home-case__img" src="~/images/one80/storefront.png" alt="ONE80 Revolution Shopify storefront" loading="lazy" asp-append-version="true" />
                <span class="home-case__badge">Shopify case study</span>
            </div>
        </article>
    </div>
</section>

<section class="home-stats home-stats--motion" aria-label="Experience and expertise">
    <div class="home-stats__ambient" aria-hidden="true">
        <span class="home-stats__orb home-stats__orb--amber"></span>
        <span class="home-stats__orb home-stats__orb--violet"></span>
        <span class="home-stats__orb home-stats__orb--mint"></span>
    </div>
    <div class="container">
        <header class="home-stats__header home-stats__header--open">
            <p class="home-stats__eyebrow">What I do</p>
            <h2 class="home-stats__title">
                <span class="home-stats__title-line">Developer who designs,</span>
                <span class="home-stats__title-line home-stats__title-line--accent">designer who ships</span>
            </h2>
            <p class="home-stats__lead">
                <span class="home-stats__experience">5+ years</span>
                building Shopify storefronts, full-stack apps, WordPress themes, and brand systems — from first sketch to production and support.
            </p>
            <div class="home-stats__metrics" aria-label="Highlights">
                <div class="home-stats__metric"><strong>Shopify</strong><span>storefronts &amp; themes</span></div>
                <div class="home-stats__metric"><strong>Full-stack</strong><span>APIs to UI</span></div>
                <div class="home-stats__metric"><strong>Design</strong><span>brand to pixels</span></div>
                <div class="home-stats__metric"><strong>Launch</strong><span>hosting &amp; support</span></div>
            </div>
        </header>

        <div class="home-stats__grid home-stats__grid--bento">
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="fullstack">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fas fa-laptop-code"></i></p>
                    <span class="home-stat-card__num">01</span>
                </div>
