@model AnastasiiaPortfolio.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "page-home theme-editorial";
}

<section id="home" class="ghero" data-ghero aria-label="Introduction">
    <div class="ghero__panels">
        <div class="gpanel gframe g1" data-gesture="1">
            <svg class="g1__svg" aria-hidden="true" focusable="false"></svg>
            <div class="gframe__main">
                <p class="gframe__hint g1__prompt">
                    <span class="g1__ask">Draw something <em>pretty</em> for me.</span>
                    <span class="g1__how">
                        <svg class="g1__cue" viewBox="0 0 84 28" width="58" height="20" aria-hidden="true" focusable="false">
                            <path class="g1__cue-rest" d="M2 18C14 6 20 24 34 14s20-12 32 2 14 8 16-4" />
                            <path class="g1__cue-draw" pathLength="100" d="M2 18C14 6 20 24 34 14s20-12 32 2 14 8 16-4" />
                        </svg>
                        Drag anywhere on this screen
                    </span>
                </p>
                <p class="g1__turn" data-turn hidden>My turn<em>.</em></p>
                <button type="button" class="gframe__again" data-again hidden>Draw again</button>
                <div class="gframe__body" data-lock>
                    <h1>All the <em>work.</em></h1>
                    <div class="gframe__actions">
                        <a class="gbtn gbtn--fill" asp-controller="Home" asp-action="Projects">View my work <span class="gbtn__arr" aria-hidden="true">&rarr;</span></a>
                        <a class="gbtn gbtn--line" asp-controller="Home" asp-action="Resume">Resume <span class="gbtn__arr" aria-hidden="true">&nearr;</span></a>
                        <button type="button" class="gbtn gbtn--line" data-straighten hidden>Straighten it</button>
                    </div>
                </div>
                <div class="g1__lane" data-lane aria-hidden="true"></div>
            </div>
        </div>
    </div>
    <div class="ghero__foot">
        <p class="ghero__sign">
            <span class="ghero__name">Anastasiia Khrustaleva</span>
            <span class="ghero__place">Ontario</span>
        </p>
        <p class="ghero__role">
            <span class="ghero__hire">Open to Software Engineering &amp; Web Development Roles</span>
        </p>
    </div>
</section>
<section class="story-scroll story-scroll--after-hero" id="process" aria-label="How I work">
    <div class="container">
        <div class="story-scroll__inner">
            <div class="story-scroll__visual-wrap">
                <div class="story-scroll__visual" id="storyVisual">
                    <div class="story-scroll__panel is-active" data-story-panel="design">
                        <img class="home-frame__img" src="https://images.unsplash.com/photo-1581291518633-83b4ebd1d83e?auto=format&fit=crop&w=1400&q=80" alt="Wireframe of a product interface" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 01</p>
                            <p class="story-scroll__panel-title">Strategy, UX &amp; visual direction</p>
                        </div>
                    </div>
                    <div class="story-scroll__panel" data-story-panel="build">
                        <img class="home-frame__img" src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1400&q=80" alt="A developer and a colleague reviewing code" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 02</p>
                            <p class="story-scroll__panel-title">Development that ships clean</p>
                        </div>
                    </div>
                    <div class="story-scroll__panel" data-story-panel="launch">
                        <img class="home-frame__img" src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=1400&q=80" alt="A colleague reviewing a live interface with a teammate" loading="lazy" />
                        <div class="story-scroll__panel-overlay">
                            <p class="story-scroll__panel-tag">Step 03</p>
                            <p class="story-scroll__panel-title">Deploy, measure &amp; improve</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="story-scroll__steps" role="list">
                <article class="story-step is-active" data-story-step="design" role="listitem" tabindex="0">
                    <p class="story-step__num">01 — Design</p>
                    <h3>Strategy, UX, and visual direction</h3>
                    <p>Page structure, user flows, and branded interfaces — from wireframes to polished UI — so every project starts with clarity and conversion in mind.</p>
                </article>
                <article class="story-step" data-story-step="build" role="listitem" tabindex="0">
                    <p class="story-step__num">02 — Build</p>
                    <h3>Development that ships clean</h3>
                    <p>ASP.NET Core, JavaScript, WordPress, Shopify, APIs, and databases — responsive, accessible, and ready for real users and real traffic.</p>
                </article>
                <article class="story-step" data-story-step="launch" role="listitem" tabindex="0">
                    <p class="story-step__num">03 — Launch</p>
                    <h3>Deploy, measure, improve</h3>
                    <p>Hosting, SEO, performance tuning, and post-launch updates — so the site stays fast, findable, and easy to grow after go-live.</p>
                </article>
            </div>
        </div>

        <article class="home-case home-case--after-process" aria-labelledby="home-case-one80-title">
            <div class="home-case__body">
                <p class="home-case__eyebrow">Featured Shopify work</p>
                <h3 class="home-case__title" id="home-case-one80-title">ONE80 Revolution</h3>
                <p class="home-case__lead">Precision hydration brand storefront — product pages, mobile UX, checkout setup, redirects, and post-launch merchant support.</p>
                <ul class="home-case__points">
                    <li><strong>Problem</strong> Make a technical product feel simple to buy on mobile.</li>
                    <li><strong>Approach</strong> Design the purchase path, then ship it in Shopify theme code.</li>
                    <li><strong>Result</strong> Live storefront with clearer PDPs and ongoing updates.</li>
                </ul>
                <div class="home-case__stack" aria-label="Stack">
                    <span>Shopify</span><span>Liquid</span><span>JavaScript</span><span>CSS</span><span>Checkout UX</span>
                </div>
                <a asp-controller="Home" asp-action="Projects" class="home-case__link">See all projects <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="home-case__media">
                <img class="home-case__img" src="~/images/one80/lifestyle.png" alt="ONE80 bottle with an athlete in the gym" loading="lazy" asp-append-version="true" />
                <span class="home-case__badge">Shopify case study</span>
            </div>
        </article>
    </div>
</section>

<section class="home-stats home-stats--motion" aria-label="Experience and expertise">
    <div class="home-stats__ambient" aria-hidden="true">
        <span class="home-stats__orb home-stats__orb--amber"></span>
        <span class="home-stats__orb home-stats__orb--violet"></span>
        <span class="home-stats__orb home-stats__orb--mint"></span>
    </div>
    <div class="container">
        <header class="home-stats__header home-stats__header--open">
            <p class="home-stats__eyebrow">What I do</p>
            <h2 class="home-stats__title">
                <span class="home-stats__title-line">Developer who designs,</span>
                <span class="home-stats__title-line home-stats__title-line--accent">designer who ships</span>
            </h2>
            <p class="home-stats__lead">
                <span class="home-stats__experience">5+ years</span>
                building Shopify storefronts, full-stack apps, WordPress themes, and brand systems — from first sketch to production and support.
            </p>
            <div class="home-stats__metrics" aria-label="Highlights">
                <div class="home-stats__metric"><strong>Shopify</strong><span>storefronts &amp; themes</span></div>
                <div class="home-stats__metric"><strong>Full-stack</strong><span>APIs to UI</span></div>
                <div class="home-stats__metric"><strong>Design</strong><span>brand to pixels</span></div>
                <div class="home-stats__metric"><strong>Launch</strong><span>hosting &amp; support</span></div>
            </div>
        </header>

        <div class="home-stats__grid home-stats__grid--bento">
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="fullstack">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fas fa-laptop-code"></i></p>
                    <span class="home-stat-card__num">01</span>
                </div>
                <h3 class="home-stat-card__label">Full-stack development</h3>
                <p class="home-stat-card__detail">Business logic, APIs, databases, auth, admin panels, and interactive features — not just front-end mockups.</p>
                <div class="home-stat-card__tags" aria-label="Development skills">
                    <span>ASP.NET Core</span><span>C#</span><span>REST APIs</span><span>Entity Framework</span><span>MongoDB</span><span>SignalR</span>
                </div>
            </article>
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="ecommerce">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fab fa-shopify"></i></p>
                    <span class="home-stat-card__num">02</span>
                </div>
                <h3 class="home-stat-card__label">E-commerce &amp; Shopify</h3>
                <p class="home-stat-card__detail">Storefronts, product pages, checkout flows, Liquid themes, mobile UX, redirects, subscriptions, and post-launch merchant support.</p>
                <div class="home-stat-card__tags" aria-label="E-commerce skills">
                    <span>Shopify</span><span>Liquid</span><span>WooCommerce</span><span>Checkout UX</span><span>Conversion design</span>
                </div>
            </article>
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="wordpress">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fab fa-wordpress"></i></p>
                    <span class="home-stat-card__num">03</span>
                </div>
                <h3 class="home-stat-card__label">WordPress &amp; CMS builds</h3>
                <p class="home-stat-card__detail">Custom themes, Gutenberg blocks, WooCommerce, ACF, block patterns, SEO plugins, and production-ready site structure.</p>
                <div class="home-stat-card__tags" aria-label="CMS skills">
                    <span>WordPress</span><span>Gutenberg</span><span>ACF</span><span>theme.json</span><span>Rank Math</span><span>Kinsta</span>
                </div>
            </article>
            <article class="home-stat-card reveal-ready" tabindex="0" data-stat-card="design">
                <div class="home-stat-card__top">
                    <p class="home-stat-card__icon" aria-hidden="true"><i class="fas fa-palette"></i></p>
                    <span class="home-stat-card__num">04</span>
                </div>
                <h3 class="home-stat-card__label">UI/UX, brand &amp; creative</h3>
                <p class="home-stat-card__detail">Wireframes, visual systems, landing pages, ad creative, social content, and polished interfaces that match the brand.</p>
                <div class="home-stat-card__tags" aria-label="Design skills">
                    <span>UI/UX</span><span>Figma</span><span>Photoshop</span><span>Brand design</span><span>Canva</span><span>CapCut</span>
                </div>
            </article>
        </div>

        <div class="home-stats__delivered reveal-ready" data-home-stats-chips>
            <div class="home-stats__delivered-head">
                <p class="home-stats__delivered-eyebrow">Delivered</p>
                <h3 class="home-stats__delivered-title">Types of work I've done</h3>
                <p class="home-stats__delivered-lead">Real project shapes — click any to highlight.</p>
            </div>
            <div class="home-stats__delivered-lanes">
                <div class="home-stats__delivered-lane" data-accent="amber">
                    <p class="home-stats__delivered-label"><i class="fas fa-globe" aria-hidden="true"></i> Sites &amp; brands</p>
                    <div class="home-stats__delivered-tags">
                        <span>Client websites &amp; rebrands</span>
                        <span>Event &amp; landing pages</span>
                        <span>Portfolio &amp; demo sites</span>
                        <span>Brand systems &amp; visual identity</span>
                    </div>
                </div>
                <div class="home-stats__delivered-lane" data-accent="mint">
                    <p class="home-stats__delivered-label"><i class="fas fa-bag-shopping" aria-hidden="true"></i> E-commerce</p>
                    <div class="home-stats__delivered-tags">
                        <span>Shopify storefronts &amp; theme builds</span>
                        <span>WordPress &amp; WooCommerce sites</span>
                        <span>Merchant &amp; client support</span>
                    </div>
                </div>
                <div class="home-stats__delivered-lane" data-accent="ink">
                    <p class="home-stats__delivered-label"><i class="fas fa-table-cells" aria-hidden="true"></i> Apps &amp; products</p>
                    <div class="home-stats__delivered-tags">
                        <span>CRM &amp; dashboard apps</span>
                        <span>Admin panels &amp; internal tools</span>
                        <span>Playable web games</span>
                    </div>
                </div>
                <div class="home-stats__delivered-lane" data-accent="sky">
                    <p class="home-stats__delivered-label"><i class="fas fa-rocket" aria-hidden="true"></i> Growth &amp; ops</p>
                    <div class="home-stats__delivered-tags">
                        <span>Marketing &amp; ad creative</span>
                        <span>Email campaigns &amp; automation</span>
                        <span>SEO &amp; performance tuning</span>
                        <span>Social content &amp; video edits</span>
                        <span>Hosting, DNS &amp; deployment</span>
                        <span>IT troubleshooting &amp; QA</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="home-stats__knowhow">
            <div class="home-stats__knowhow-head">
                <div class="home-stats__knowhow-intro">
                    <p class="home-stats__knowhow-eyebrow">Toolbox</p>
                    <h3 class="home-stats__knowhow-title">Technologies &amp; tools I work with</h3>
                    <p class="home-stats__knowhow-lead">Filter by lane — languages, Shopify, design, cloud, workflow.</p>
                </div>
                <a asp-controller="Home" asp-action="Skills" class="home-stats__skills-link home-stats__skills-link--top">Full skills <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="home-stats__filter" role="tablist" aria-label="Filter technology categories">
                <button type="button" class="home-stats__filter-btn is-active" data-knowhow-filter="all" role="tab" aria-selected="true">All</button>
                <button type="button" class="home-stats__filter-btn" data-knowhow-filter="languages" role="tab" aria-selected="false">Languages</button>
                <button type="button" class="home-stats__filter-btn" data-knowhow-filter="frameworks" role="tab" aria-selected="false">Frameworks</button>
                <button type="button" class="home-stats__filter-btn" data-knowhow-filter="cms" role="tab" aria-selected="false">CMS</button>
                <button type="button" class="home-stats__filter-btn" data-knowhow-filter="databases" role="tab" aria-selected="false">Cloud</button>
                <button type="button" class="home-stats__filter-btn" data-knowhow-filter="devops" role="tab" aria-selected="false">DevOps</button>
                <button type="button" class="home-stats__filter-btn" data-knowhow-filter="design" role="tab" aria-selected="false">Design</button>
                <button type="button" class="home-stats__filter-btn" data-knowhow-filter="marketing" role="tab" aria-selected="false">Marketing</button>
                <button type="button" class="home-stats__filter-btn" data-knowhow-filter="collaboration" role="tab" aria-selected="false">Workflow</button>
            </div>
            <div class="home-stats__knowhow-grid" data-home-stats-chips>
                <div class="home-stats__knowhow-group" data-knowhow-group="languages" data-accent="amber">
                    <p class="home-stats__knowhow-label"><i class="fas fa-code" aria-hidden="true"></i> Languages</p>
                    <div class="home-stats__knowhow-tags">
                        <span>C# / .NET</span><span>JavaScript</span><span>TypeScript</span><span>HTML5</span><span>CSS3</span><span>SQL</span><span>Python</span><span>Java</span><span>PHP</span><span>Liquid</span><span>SCSS / Sass</span><span>Razor</span><span>JSON / YAML</span>
                    </div>
                </div>
                <div class="home-stats__knowhow-group" data-knowhow-group="frameworks" data-accent="ink">
                    <p class="home-stats__knowhow-label"><i class="fas fa-cubes" aria-hidden="true"></i> Frameworks &amp; libraries</p>
                    <div class="home-stats__knowhow-tags">
                        <span>ASP.NET Core MVC</span><span>Entity Framework Core</span><span>ASP.NET Identity</span><span>Razor Pages</span><span>REST APIs</span><span>SignalR</span><span>Bootstrap</span><span>Tailwind CSS</span><span>React</span><span>Next.js</span><span>jQuery</span><span>Three.js</span><span>LINQ</span>
                    </div>
                </div>
                <div class="home-stats__knowhow-group home-stats__knowhow-group--wide" data-knowhow-group="cms" data-accent="mint">
                    <p class="home-stats__knowhow-label"><i class="fab fa-shopify" aria-hidden="true"></i> CMS &amp; e-commerce</p>
                    <div class="home-stats__knowhow-tags">
                        <span>Shopify</span><span>Shopify Themes</span><span>Shopify Admin</span><span>Subscriptions</span><span>WordPress</span><span>Gutenberg / FSE</span><span>WooCommerce</span><span>ACF</span><span>WPForms</span><span>Block Patterns</span><span>Rank Math</span><span>Kinsta</span>
                    </div>
                </div>
                <div class="home-stats__knowhow-group" data-knowhow-group="databases" data-accent="sky">
                    <p class="home-stats__knowhow-label"><i class="fas fa-cloud" aria-hidden="true"></i> Databases &amp; cloud</p>
                    <div class="home-stats__knowhow-tags">
                        <span>SQL Server</span><span>SQLite</span><span>MongoDB</span><span>MongoDB Atlas</span><span>Firebase</span><span>Railway</span><span>Azure</span><span>AWS</span><span>Google Cloud</span><span>Docker</span><span>Cloudinary</span>
                    </div>
                </div>
                <div class="home-stats__knowhow-group" data-knowhow-group="devops" data-accent="stone">
                    <p class="home-stats__knowhow-label"><i class="fas fa-terminal" aria-hidden="true"></i> DevOps &amp; tooling</p>
                    <div class="home-stats__knowhow-tags">
                        <span>Git / GitHub</span><span>GitLab</span><span>Bitbucket</span><span>GitHub Actions</span><span>CI/CD</span><span>npm / yarn</span><span>Postman</span><span>VS Code</span><span>Visual Studio</span><span>dotnet CLI</span><span>cPanel</span><span>DNS / SSL</span><span>Vercel</span><span>Netlify</span><span>Linux basics</span>
                    </div>
                </div>
                <div class="home-stats__knowhow-group" data-knowhow-group="design" data-accent="rose">
                    <p class="home-stats__knowhow-label"><i class="fas fa-pen-nib" aria-hidden="true"></i> Design &amp; creative</p>
                    <div class="home-stats__knowhow-tags">
                        <span>Figma</span><span>Photoshop</span><span>Illustrator</span><span>Premiere Pro</span><span>After Effects</span><span>Lightroom</span><span>Sketch</span><span>Canva</span><span>CapCut</span><span>Midjourney</span><span>Adobe Firefly</span><span>Wireframes</span><span>Prototyping</span><span>Brand systems</span><span>AI-assisted design</span>
                    </div>
                </div>
                <div class="home-stats__knowhow-group" data-knowhow-group="marketing" data-accent="orange">
                    <p class="home-stats__knowhow-label"><i class="fas fa-chart-line" aria-hidden="true"></i> Marketing &amp; analytics</p>
                    <div class="home-stats__knowhow-tags">
                        <span>Google Analytics</span><span>Search Console</span><span>Semrush</span><span>SEO audits</span><span>Zoho CRM</span><span>Mailchimp</span><span>Meta / social ads</span><span>Conversion UX</span><span>Core Web Vitals</span>
                    </div>
                </div>
                <div class="home-stats__knowhow-group home-stats__knowhow-group--wide" data-knowhow-group="collaboration" data-accent="clay">
                    <p class="home-stats__knowhow-label"><i class="fas fa-people-group" aria-hidden="true"></i> Collaboration &amp; workflow</p>
                    <div class="home-stats__knowhow-tags">
                        <span>Jira</span><span>Trello</span><span>Slack</span><span>Notion</span><span>Agile / sprints</span><span>Client communication</span><span>Technical docs</span><span>Launch &amp; post-launch QA</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
