@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Linden Homes</title>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            font-family: Outfit, "Segoe UI", sans-serif;
            color: #1d2a24;
            background: #f3f6f2;
        }
        a { color: inherit; text-decoration: none; }
        header {
            position: sticky;
            top: 0;
            z-index: 2;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.9rem 1.25rem;
            background: rgba(243, 246, 242, 0.94);
            backdrop-filter: blur(10px);
        }
        .mark { font-family: Fraunces, Georgia, serif; font-size: 1.35rem; }
        nav { display: flex; gap: 1rem; }
        .hero {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            min-height: 520px;
            margin: 0 1rem 2rem;
            border-radius: 1.3rem;
            overflow: hidden;
            background: #1d2a24;
            color: #f7faf6;
        }
        .hero-copy {
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            gap: 0.8rem;
            padding: 2rem;
        }
        .kicker {
            margin: 0;
            font-size: 0.72rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }
        h1, h2 { font-family: Fraunces, Georgia, serif; font-weight: 500; letter-spacing: -0.03em; }
        h1 { margin: 0; font-size: clamp(2.6rem, 5vw, 4.4rem); line-height: 0.95; }
        .hero-copy p { margin: 0; max-width: 26rem; }
        .hero-photo { position: relative; min-height: 280px; }
        .hero-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
        .btn {
            display: inline-block;
            width: fit-content;
            background: #f7faf6;
            color: #1d2a24;
            border-radius: 999px;
            padding: 0.75rem 1.1rem;
            font-weight: 600;
        }
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            padding: 0 1.25rem 1rem;
        }
        .toolbar h2 { margin: 0.15rem 0 0; font-size: clamp(1.8rem, 3vw, 2.4rem); }
        .town-filter { display: grid; gap: 0.3rem; font-size: 0.78rem; color: #5c6b63; }
        select {
            min-width: 11rem;
            border: 0;
            border-radius: 0.8rem;
            padding: 0.75rem 0.9rem;
            font: inherit;
            color: #1d2a24;
            background: #fff;
        }
        .count { margin: 0 1.25rem 0.8rem; color: #5c6b63; }
        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.9rem;
            padding: 0 1.25rem 2rem;
        }
        article {
            background: #fff;
            border-radius: 1rem;
            overflow: hidden;
            border: 1px solid #e3ebe4;
        }
        article img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
        .body { display: grid; gap: 0.25rem; padding: 1rem 1.05rem 1.15rem; }
        .town { margin: 0; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: #5c6b63; }
        .body h2 { margin: 0; font-size: 1.35rem; }
        .meta, .price { margin: 0; }
        .meta { color: #5c6b63; }
        .price { font-family: Fraunces, Georgia, serif; font-size: 1.25rem; }
        article.is-hidden { display: none; }
        .empty { display: none; margin: 0 1.25rem 2rem; }
        .empty.is-on { display: block; }
        footer { padding: 0 1.25rem 2rem; color: #5c6b63; font-size: 0.85rem; }
        .divi-bar {
            position: sticky;
            top: 0;
            z-index: 40;
            display: flex;
            align-items: center;
            gap: 0.55rem;
            min-height: 42px;
            padding: 0.4rem 0.8rem;
            background: #2b2150;
            color: #fff;
            font-size: 0.82rem;
        }
        .divi-mark {
            width: 1.35rem;
            height: 1.35rem;
            display: grid;
            place-items: center;
            border-radius: 0.35rem;
            background: #7c3aed;
            font-weight: 700;
        }
        .divi-mode { color: #d6c7ff; }
        .divi-page { margin-right: auto; }
        .divi-bar button {
            border: 0;
            border-radius: 999px;
            background: #7c3aed;
            color: #fff;
            font: inherit;
            font-weight: 600;
            padding: 0.32rem 0.75rem;
            cursor: pointer;
        }
        body.is-builder .et_pb_section,
        body.is-builder .et_pb_row,
        body.is-builder .et_pb_module { position: relative; }
        body.is-builder .et_pb_section { outline: 1px dashed rgba(124, 58, 237, 0.9); }
        body.is-builder .et_pb_row { outline: 1px dashed rgba(26, 174, 159, 0.95); }
        body.is-builder .et_pb_module { outline: 1px dashed rgba(46, 163, 242, 0.95); }
        body.is-builder .et_pb_section::before,
        body.is-builder .et_pb_row::before,
        body.is-builder .et_pb_module::before {
            position: absolute;
            top: 6px;
            left: 6px;
            z-index: 6;
            padding: 0.12rem 0.4rem;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            pointer-events: none;
        }
        body.is-builder .et_pb_section::before { content: "Section"; background: #7c3aed; }
        body.is-builder .hero.et_pb_section::before { content: "Fullwidth Header"; }
        body.is-builder .et_pb_row::before { content: "Row"; background: #1aae9f; }
        body.is-builder .et_pb_module::before { content: attr(data-module); left: auto; right: 6px; background: #2ea3f2; }
        @@media (max-width: 800px) {
            .hero, .grid { grid-template-columns: 1fr; }
            .hero-photo { min-height: 220px; }
            .toolbar { align-items: stretch; flex-direction: column; }
            select { width: 100%; }
        }
    </style>
</head>
<body class="is-builder">
    <div class="divi-bar">
        <span class="divi-mark">D</span>
        <strong>Divi</strong>
        <span class="divi-mode">Visual Builder</span>
        <span class="divi-page">Linden Homes</span>
        <button type="button" id="diviView">Preview</button>
    </div>
    <header class="et_pb_module" data-module="Menu">
        <a class="mark" href="#top">Linden Homes</a>
        <nav><a href="#listings">Listings</a></nav>
    </header>
    <section class="hero et_pb_section" id="top">
        <div class="hero-copy">
            <p class="kicker">Niagara and Hamilton</p>
            <h1>Houses with room to breathe.</h1>
            <p>Three homes on the market. Filter the list by town.</p>
            <a class="btn" href="#listings">See the homes</a>
        </div>
        <div class="hero-photo">
            <img src="/images/wordpress/linden-hero.jpg" alt="A modern house among trees" />
        </div>
    </section>
    <section class="et_pb_section" id="listings">
        <div class="toolbar">
            <div>
                <p class="kicker">Listings</p>
                <h2>Homes for sale</h2>
            </div>
            <label class="town-filter">Town
                <select id="place">
                    <option value="all">All towns</option>
                    <option value="niagara">Niagara</option>
                    <option value="hamilton">Hamilton</option>
                </select>
            </label>
        </div>
        <p class="count" id="count">3 homes</p>
        <div class="grid et_pb_row">
            <article class="et_pb_module" data-module="Blurb" data-place="niagara">
                <img src="/images/wordpress/linden-maple.jpg" alt="Maple Court" />
                <div class="body">
                    <p class="town">Niagara</p>
                    <h2>Maple Court</h2>
                    <p class="meta">3 beds · 2 baths</p>
                    <p class="price">$829,000</p>
                </div>
            </article>
            <article class="et_pb_module" data-module="Blurb" data-place="hamilton">
                <img src="/images/wordpress/linden-king.jpg" alt="King Street" />
                <div class="body">
                    <p class="town">Hamilton</p>
                    <h2>King Street</h2>
                    <p class="meta">2 beds · 1 bath</p>
                    <p class="price">$615,000</p>
                </div>
            </article>
            <article class="et_pb_module" data-module="Blurb" data-place="niagara">
                <img src="/images/wordpress/linden-lake.jpg" alt="Lake Lane" />
                <div class="body">
                    <p class="town">Niagara</p>
                    <h2>Lake Lane</h2>
                    <p class="meta">4 beds · 3 baths</p>
                    <p class="price">$1,140,000</p>
                </div>
            </article>
        </div>
        <p class="empty" id="empty">No homes in that town.</p>
    </section>
    <footer>Built with Divi on WordPress. Homes are filtered by town.</footer>
    <script>
        document.getElementById("diviView").addEventListener("click", function () {
            var on = document.body.classList.toggle("is-builder");
            this.textContent = on ? "Preview" : "Builder";
        });
        var select = document.getElementById("place");
        var cards = document.querySelectorAll("#listings article");
        var count = document.getElementById("count");
        var empty = document.getElementById("empty");
        function applyFilter() {
            var place = select.value;
            var shown = 0;
            cards.forEach(function (card) {
                var hide = place !== "all" && card.dataset.place !== place;
                card.classList.toggle("is-hidden", hide);
                if (!hide) shown += 1;
            });
            count.textContent = shown === 1 ? "1 home" : shown + " homes";
            empty.classList.toggle("is-on", shown === 0);
        }
        select.addEventListener("change", applyFilter);
    </script>
</body>
</html>
